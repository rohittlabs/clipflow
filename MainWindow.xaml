<Window x:Class="ClipFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipFlow"
        Width="660"
        Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        Icon ="appicon.ico"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <!-- ── Fonts ── -->
        <FontFamily x:Key="PrimaryFont">Segoe UI Variable Display, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, monospace</FontFamily>

        <!-- ── Scrollbar style ── -->
        <Style x:Key="SlimScrollBar"
                TargetType="ScrollBar">
            <Setter Property="Width"
                    Value="4"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                    IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ScrollThumb}"
                                                        CornerRadius="2"
                                                        Margin="1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollViewer"
                TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource SlimScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Icon button ── -->
        <Style x:Key="IconBtn"
                TargetType="Button">
            <Setter Property="Width"
                    Value="34"/>
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource ButtonPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── List item ── -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin"
                    Value="10,3"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="14"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Padding="14,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource ItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource ItemSelected}"/>
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ItemSelectedBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ListBox ── -->
        <Style TargetType="ListBox">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                                      Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Root with entrance animation -->
    <Grid x:Name="RootGrid"
            Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate"
                    Y="16"/>
        </Grid.RenderTransform>

        <!-- Outer shadow border -->
        <Border x:Name="MainBorder"
                CornerRadius="22"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                Margin="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48"
                                  ShadowDepth="8"
                                  Direction="270"
                                  Opacity="0.22"
                                  Color="#000000"/>
            </Border.Effect>

            <!-- Inner layer for glass effect -->
            <Border CornerRadius="22"
                    Background="{DynamicResource SurfaceOverlay}"
                    BorderBrush="{DynamicResource InnerBorderColor}"
                    BorderThickness="1"
                    ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="Auto"
                                MaxHeight="28"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="52"/>
                    </Grid.RowDefinitions>

                    <!-- ── Header ── -->
                    <Grid Grid.Row="0"
                            Margin="22,0,18,0">
                        <!-- Drag area -->
                        <Rectangle Fill="Transparent"
                                   MouseLeftButtonDown="Header_MouseLeftButtonDown"/>

                        <DockPanel VerticalAlignment="Center">

                            <!-- Branding -->
                            <StackPanel Orientation="Horizontal"
                                        DockPanel.Dock="Left"
                                        VerticalAlignment="Center">

                                <!-- Logo mark -->
                                <Border Width="40"
                                        Height="40"
                                        CornerRadius="13"
                                        Background="{DynamicResource AccentGradient}"
                                        Margin="0,0,13,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12"
                                                          ShadowDepth="0"
                                                          Opacity="0.4"
                                                          Color="#6E5CFF"/>
                                    </Border.Effect>
                                    <TextBlock Text="C"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ClipFlow"
                                               Foreground="{DynamicResource PrimaryText}"
                                               FontWeight="SemiBold"
                                               FontSize="17"
                                               FontFamily="{StaticResource PrimaryFont}"/>
                                    <TextBlock x:Name="ItemCountText"
                                               Text="0 items"
                                               Foreground="{DynamicResource TertiaryText}"
                                               FontSize="11.5"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal"
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,2,0">

                                <Button x:Name="ThemeButton"
                                        Content="◐"
                                        Style="{StaticResource IconBtn}"
                                        FontSize="15"
                                        Foreground="{DynamicResource SecondaryText}"
                                        Click="ThemeButton_Click"
                                        ToolTip="Toggle theme  (Ctrl+T)"/>

                                <Button Content="🗑"
                                        Style="{StaticResource IconBtn}"
                                        FontSize="13"
                                        Margin="2,0"
                                        Foreground="{DynamicResource SecondaryText}"
                                        Click="ClearButton_Click"
                                        ToolTip="Clear all history"/>

                                <Button Content="✕"
                                        Style="{StaticResource IconBtn}"
                                        FontSize="13"
                                        Foreground="{DynamicResource SecondaryText}"
                                        Click="CloseButton_Click"
                                        ToolTip="Close  (Esc)"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <!-- ── Divider ── -->
                    <Rectangle Grid.Row="0"
                               Height="1"
                               VerticalAlignment="Bottom"
                               Fill="{DynamicResource DividerColor}"
                               Margin="22,0"/>

                    <!-- ── Search ── -->
                    <Border Grid.Row="1"
                            Margin="18,12,18,0"
                            CornerRadius="14"
                            Background="{DynamicResource SearchBg}"
                            BorderBrush="{DynamicResource SearchBorder}"
                            BorderThickness="1.2"
                            x:Name="SearchBorder">

                        <Grid Height="42"
                                VerticalAlignment="Center">

                            <!-- Search icon -->
                            <TextBlock Text="⌕"
                                       FontSize="18"
                                       Foreground="{DynamicResource TertiaryText}"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,1"
                                       IsHitTestVisible="False"
                                       FontFamily="{StaticResource PrimaryFont}"/>

                            <!-- Placeholder -->
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Search clipboard history..."
                                       Foreground="{DynamicResource TertiaryText}"
                                       FontSize="14.5"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       VerticalAlignment="Center"
                                       Margin="44,0,0,0"
                                       IsHitTestVisible="False"/>

                            <!-- Input -->
                            <TextBox x:Name="SearchBox"
                                     FontSize="14.5"
                                     FontFamily="{StaticResource PrimaryFont}"
                                     Foreground="{DynamicResource PrimaryText}"
                                     CaretBrush="{DynamicResource Accent}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="44,0,120,0"
                                     VerticalAlignment="Center"
                                     Padding="0"
                                     TextChanged="SearchBox_TextChanged"/>

                            <!-- Hotkey badge -->
                            <Border Background="{DynamicResource BadgeBg}"
                                    BorderBrush="{DynamicResource BadgeBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="8,4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <TextBlock Text="Ctrl+Shift+V"
                                           FontSize="10.5"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource TertiaryText}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ── Section label ── -->
                    <TextBlock x:Name="SectionLabel"
                               Grid.Row="2"
                               Text="RECENT"
                               Foreground="{DynamicResource TertiaryText}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource PrimaryFont}"
                               Margin="26,8,0,0"
                               VerticalAlignment="Bottom"/>

                    <!-- ── Items list ── -->
                    <ListBox x:Name="ItemsList"
                             Grid.Row="3"
                             Margin="8,6,8,4"
                             MouseDoubleClick="ItemsList_MouseDoubleClick">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon for text items -->
                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="11"
                                            Background="{DynamicResource IconBg}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding TextVisibility}">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Thumbnail for image items -->
                                    <Border Width="38"
                                            Height="38"
                                            CornerRadius="11"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding ImageVisibility}"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ImagePath}"
                                                        Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>

                                    <!-- Text content -->
                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,12,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource PrimaryText}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Preview}"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   FontSize="12"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0"
                                                   Opacity="0.85"/>
                                    </StackPanel>

                                    <!-- Right meta -->
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                MinWidth="52">
                                        <TextBlock Text="{Binding TimeLabel}"
                                                   Foreground="{DynamicResource TertiaryText}"
                                                   FontSize="10.5"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding PinLabel}"
                                                   Foreground="{DynamicResource Accent}"
                                                   FontSize="11"
                                                   Visibility="{Binding PinVisibility}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ── Empty state ── -->
                    <StackPanel x:Name="EmptyState"
                                Grid.Row="3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="📋"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   Opacity="0.3"/>
                        <TextBlock Text="No clipboard history yet"
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontSize="14"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   Opacity="0.6"/>
                        <TextBlock Text="Copy something to get started"
                                   Foreground="{DynamicResource TertiaryText}"
                                   FontSize="12"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Opacity="0.5"/>
                    </StackPanel>

                    <!-- ── Footer ── -->
                    <Border Grid.Row="4"
                            Background="{DynamicResource FooterBg}"
                            BorderBrush="{DynamicResource DividerColor}"
                            BorderThickness="0,1,0,0">

                        <Grid Margin="22,0,22,0"
                                Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left shortcuts -->
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Opacity="0.7">
                                <Border Background="{DynamicResource BadgeBg}"
                                        CornerRadius="5"
                                        Padding="6,3"
                                        Margin="0,0,5,0">
                                    <TextBlock Text="↑↓"
                                               FontSize="10"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource TertiaryText}"/>
                                </Border>
                                <TextBlock Text="navigate"
                                           FontSize="11"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           Foreground="{DynamicResource TertiaryText}"
                                           VerticalAlignment="Center"/>

                                <Border Background="{DynamicResource BadgeBg}"
                                        CornerRadius="5"
                                        Padding="6,3"
                                        Margin="10,0,5,0">
                                    <TextBlock Text="↵"
                                               FontSize="10"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource TertiaryText}"/>
                                </Border>
                                <TextBlock Text="paste"
                                           FontSize="11"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           Foreground="{DynamicResource TertiaryText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Center status -->
                            <TextBlock x:Name="FooterStatus"
                                       Grid.Column="1"
                                       Text="Ready"
                                       Foreground="{DynamicResource Accent}"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       VerticalAlignment="Center"/>

                            <!-- Right shortcuts -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Opacity="0.7">
                                <Border Background="{DynamicResource BadgeBg}"
                                        CornerRadius="5"
                                        Padding="6,3"
                                        Margin="0,0,5,0">
                                    <TextBlock Text="Del"
                                               FontSize="10"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource TertiaryText}"/>
                                </Border>
                                <TextBlock Text="remove"
                                           FontSize="11"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           Foreground="{DynamicResource TertiaryText}"
                                           VerticalAlignment="Center"/>

                                <Border Background="{DynamicResource BadgeBg}"
                                        CornerRadius="5"
                                        Padding="6,3"
                                        Margin="10,0,5,0">
                                    <TextBlock Text="⌘P"
                                               FontSize="10"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource TertiaryText}"/>
                                </Border>
                                <TextBlock Text="pin"
                                           FontSize="11"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           Foreground="{DynamicResource TertiaryText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>