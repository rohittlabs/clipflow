<Window x:Class="ClipFlow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipFlow Settings"
        Width="560"
        Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <FontFamily x:Key="PrimaryFont">Segoe UI Variable Display, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, monospace</FontFamily>

        <!-- Section header -->
        <Style x:Key="SectionHeader"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource TertiaryText}"/>
            <Setter Property="FontSize"
                    Value="10.5"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Margin"
                    Value="0,20,0,10"/>
        </Style>

        <!-- Setting card -->
        <Style x:Key="SettingCard"
                TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource ItemHover}"/>
            <Setter Property="CornerRadius"
                    Value="12"/>
            <Setter Property="Padding"
                    Value="16,14"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <!-- Setting title -->
        <Style x:Key="SettingTitle"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontSize"
                    Value="13.5"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource PrimaryFont}"/>
        </Style>

        <!-- Setting description -->
        <Style x:Key="SettingDescription"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize"
                    Value="11.5"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Margin"
                    Value="0,3,0,0"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>

        <!-- Modern toggle switch -->
        <Style x:Key="ToggleSwitch"
                TargetType="CheckBox">
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="44"
                                Height="24"
                                CornerRadius="12"
                                Background="{DynamicResource BadgeBg}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1">
                            <Border x:Name="Thumb"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="{DynamicResource SecondaryText}"
                                    HorizontalAlignment="Left"
                                    Margin="3,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Track"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Thumb"
                                        Property="Background"
                                        Value="White"/>
                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern combo box -->
        <Style x:Key="ModernCombo"
                TargetType="ComboBox">
            <Setter Property="Background"
                    Value="{DynamicResource BadgeBg}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource PrimaryFont}"/>
            <Setter Property="MinWidth"
                    Value="130"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <!-- Action button -->
        <Style x:Key="ActionButton"
                TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource BadgeBg}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="14,8"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="Medium"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource PrimaryFont}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button -->
        <Style x:Key="DangerButton"
                TargetType="Button"
                BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background"
                    Value="#352028"/>
            <Setter Property="Foreground"
                    Value="#FF6B7A"/>
            <Setter Property="BorderBrush"
                    Value="#5A2A38"/>
        </Style>

        <!-- Icon button -->
        <Style x:Key="IconBtn"
                TargetType="Button">
            <Setter Property="Width"
                    Value="34"/>
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            Margin="20">

        <Border.Effect>
            <DropShadowEffect BlurRadius="48"
                              ShadowDepth="8"
                              Direction="270"
                              Opacity="0.22"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                    Margin="22,0,18,0">
                <Rectangle Fill="Transparent"
                           MouseLeftButtonDown="Header_MouseLeftButtonDown"/>
                <DockPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center">
                        <TextBlock Text="⚙"
                                   FontSize="20"
                                   Foreground="{DynamicResource Accent}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Settings"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontWeight="SemiBold"
                                   FontSize="17"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="✕"
                            Style="{StaticResource IconBtn}"
                            FontSize="13"
                            Foreground="{DynamicResource SecondaryText}"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"/>
                </DockPanel>
            </Grid>

            <Rectangle Grid.Row="0"
                       Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{DynamicResource DividerColor}"
                       Margin="22,0"/>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="22,0,18,22">
                <StackPanel>

                    <!-- GENERAL -->
                    <TextBlock Text="GENERAL"
                            Style="{StaticResource SectionHeader}"/>

                    <!-- Auto start -->
                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows"
                                        Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Launch ClipFlow automatically when you sign in"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoStartToggle"
                                      Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Click="AutoStartToggle_Click"/>
                        </Grid>
                    </Border>

                    <!-- Theme -->
                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Dark mode"
                                        Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Use a dark color scheme. Quick toggle: Ctrl+T"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <CheckBox x:Name="DarkThemeToggle"
                                      Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Click="DarkThemeToggle_Click"/>
                        </Grid>
                    </Border>

                    <!-- Max items -->
                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="History limit"
                                        Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Maximum number of items to keep"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <ComboBox x:Name="HistoryLimitCombo"
                                      Style="{StaticResource ModernCombo}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      SelectionChanged="HistoryLimit_Changed">
                                <ComboBoxItem Content="50 items"
                                        Tag="50"/>
                                <ComboBoxItem Content="200 items"
                                        Tag="200"/>
                                <ComboBoxItem Content="500 items"
                                        Tag="500"/>
                                <ComboBoxItem Content="1000 items"
                                        Tag="1000"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- HOTKEYS -->
                    <TextBlock Text="HOTKEYS"
                            Style="{StaticResource SectionHeader}"/>

                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Open ClipFlow"
                                        Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Show the clipboard history popup"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <Border Background="{DynamicResource BadgeBg}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10,5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + Shift + V"
                                           FontSize="11.5"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource PrimaryText}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- PRIVACY -->
                    <TextBlock Text="PRIVACY"
                            Style="{StaticResource SectionHeader}"/>

                    <!-- Sensitive content blocker -->
                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    MaxWidth="400">
                                <TextBlock Text="🛡  Block sensitive content"
                                        Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Automatically ignore passwords, credit cards, API keys, and tokens"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <CheckBox x:Name="SensitiveBlockerToggle"
                                      Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Click="SensitiveBlockerToggle_Click"/>
                        </Grid>
                    </Border>

                    <!-- Pause -->
                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Pause monitoring"
                                        Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Temporarily stop saving clipboard content"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <CheckBox x:Name="PauseToggle"
                                      Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Click="PauseToggle_Click"/>
                        </Grid>
                    </Border>

                    <!-- App exclusions -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        MaxWidth="380">
                                    <TextBlock Text="🚫  Excluded apps"
                                            Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Clipboard from these apps will never be saved"
                                               Style="{StaticResource SettingDescription}"/>
                                </StackPanel>
                                <Button Content="+ Add current"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="AddCurrentAppButton_Click"
                                        ToolTip="Add the currently focused app"/>
                            </Grid>

                            <!-- Excluded apps list -->
                            <ItemsControl x:Name="ExcludedAppsList"
                                    Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BadgeBg}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,6"
                                                Margin="0,0,0,5">
                                            <Grid>
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{DynamicResource PrimaryText}"
                                                           FontSize="12"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="✕"
                                                        Tag="{Binding}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{DynamicResource SecondaryText}"
                                                        FontSize="13"
                                                        Cursor="Hand"
                                                        Padding="6,2"
                                                        Click="RemoveAppButton_Click"
                                                        ToolTip="Remove from exclusions"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoExclusionsText"
                                       Text="No apps excluded"
                                       Foreground="{DynamicResource TertiaryText}"
                                       FontSize="11.5"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       FontStyle="Italic"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto clear -->
                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Auto-delete after"
                                        Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Automatically remove old items"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <ComboBox x:Name="AutoClearCombo"
                                      Style="{StaticResource ModernCombo}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      SelectionChanged="AutoClear_Changed">
                                <ComboBoxItem Content="Never"
                                        Tag="0"/>
                                <ComboBoxItem Content="1 day"
                                        Tag="1"/>
                                <ComboBoxItem Content="7 days"
                                        Tag="7"/>
                                <ComboBoxItem Content="30 days"
                                        Tag="30"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Clear all -->
                    <Border Style="{StaticResource SettingCard}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Clear all history"
                                        Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Permanently delete all saved clipboard items"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <Button Content="Clear all"
                                    Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="ClearAllButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Data folder -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="Data location"
                                    Style="{StaticResource SettingTitle}"/>
                            <TextBlock Text="Where ClipFlow stores your clipboard history"
                                       Style="{StaticResource SettingDescription}"/>
                            <Border Background="{DynamicResource BadgeBg}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10,6"
                                    Margin="0,10,0,0">
                                <Grid>
                                    <TextBlock x:Name="DataFolderPath"
                                               Text="..."
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource SecondaryText}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,70,0"/>
                                    <Button Content="Open"
                                            Style="{StaticResource ActionButton}"
                                            Padding="10,3"
                                            FontSize="11"
                                            HorizontalAlignment="Right"
                                            Click="OpenFolderButton_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ABOUT -->
                    <TextBlock Text="ABOUT"
                            Style="{StaticResource SectionHeader}"/>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel HorizontalAlignment="Center"
                                Margin="0,8">
                            <Border Width="48"
                                    Height="48"
                                    CornerRadius="14"
                                    Background="{DynamicResource AccentGradient}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="C"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="22"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ClipFlow"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="Version 1.0.0"
                                       Foreground="{DynamicResource TertiaryText}"
                                       FontSize="11.5"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                            <TextBlock Text="A beautiful clipboard manager for Windows"
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontSize="11.5"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>